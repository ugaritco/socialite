{
    "name": "ugarit/socialite",
    "description": "Ugarit wrapper around OAuth 1 & OAuth 2 libraries.",
    "keywords": [
        "oauth",
        "ugarit"
    ],
    "license": "MIT",
    "homepage": "https://ugarit.com",
    "support": {
        "issues": "https://github.com/ugarit/socialite/issues",
        "source": "https://github.com/ugarit/socialite"
    },
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "firebase/php-jwt": "^6.4|^7.0",
        "guzzlehttp/guzzle": "^6.0|^7.0|^8.0",
        "heritage/contracts": "^1.00.00",
        "heritage/http": "^1.00.00",
        "heritage/support": "^1.00.00",
        "league/oauth1-client": "^1.11",
        "phpseclib/phpseclib": "^4.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.0",
        "orchestra/testbench": "^4.18|^5.20|^6.47|^7.55|^8.36|^9.15|^10.8|^11.0",
        "phpstan/phpstan": "^1.12.23",
        "phpunit/phpunit": "^8.0|^9.3|^10.4|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\Socialite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ugarit\\Socialite\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.x-dev"
        },
        "ugarit": {
            "providers": [
                "Ugarit\\Socialite\\SocialiteServiceProvider"
            ],
            "aliases": {
                "Socialite": "Ugarit\\Socialite\\Facades\\Socialite"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.00.00"
}
